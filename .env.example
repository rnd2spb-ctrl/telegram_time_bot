# Скопируйте этот файл в .env и заполните значения.
# BOT_TOKEN — НОВЫЙ токен, перевыпущенный через @BotFather.
BOT_TOKEN=

# Telegram ID владельца. Получите свой числовой ID через @userinfobot.
# Без OWNER_ID бот не запустится с административным доступом владельца.
OWNER_ID=

# Устаревший список для совместимости со старыми аккаунтами без записи сотрудника.
# Новых администраторов назначайте через меню бота «Редактировать сотрудника».
# Пример формата: ADMIN_IDS=111111111,222222222
ADMIN_IDS=
